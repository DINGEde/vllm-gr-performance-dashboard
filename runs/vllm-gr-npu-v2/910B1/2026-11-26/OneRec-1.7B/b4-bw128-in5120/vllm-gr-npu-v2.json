    "phase_definition": {
      "version": "vllm-gr-beam-search-v1-npu-events-v1-draft",
      "e2e": "instrumented direct beam_search_v1 call start through return",
      "prefill": "torch.npu.Event interval on the engine compute stream: entry to the PREFILL NPUEagerBeamStageRunner.execute through output-producing PREFILL sample completion; excludes frontend dispatch",
      "decode": "torch.npu.Event interval on the engine compute stream: entry to the first DECODE NPUEagerBeamStageRunner.execute through the last Decode sample completion; excludes Prefill by stream ordering and includes device idle inside Decode",
      "prefill_gpu_compute": "sum of the torch.npu.Event interval bracketing the PREFILL execute (model forward plus compute_logits) and the output-producing sample window; excludes dispatch and the execute-to-sample gap",
      "decode_gpu_compute": "sum of per-stage torch.npu.Event intervals covering each Decode execute and the sample/beam-advance window; excludes CPU prepare and inter-stage queue gaps",
      "device_idle": "device stage span minus the measured NPU compute clusters; a residual rather than an independent measurement, holding CPU launch bubbles, queue waits, and any NPU work outside those windows",
      "prefill_dispatch": "host wall from the post-synchronize submit anchor through entry to the PREFILL NPUEagerBeamStageRunner.execute; a subset of host_overhead",
      "prefill_cpu_lead": "host look-ahead depth: how far the CPU had advanced into first-Decode preparation before the NPU finished Prefill",
      "host_overhead": "e2e minus both device intervals: frontend dispatch, EngineCore queueing, and terminal collection",
      "prefill_output_consumed": "diagnostic only: submit boundary through completion of the output-producing PREFILL sample; the NPU runner has no separate async output queue, so this marks the same boundary as Prefill sample completion",
      "average": "arithmetic mean over post-canonical diagnostic observations",
      "decode_cache_semantics": "common phase; miss/hit are repeated observations, not additive components",
      "device_state_semantics": "Prefill and Decode are NPU device-timeline intervals on a single FIFO compute stream; they are additive and sum with host_overhead back to e2e. Hardware-unvalidated first draft."
    }
  },
