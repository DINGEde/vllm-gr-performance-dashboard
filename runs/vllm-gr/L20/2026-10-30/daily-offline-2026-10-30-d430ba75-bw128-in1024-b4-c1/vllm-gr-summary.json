      "phase_definition": {
        "version": "vllm-gr-canonical-beam-search-v1-e2e-v1",
        "e2e": "unmodified direct GRLLM.beam_search_v1 call start through CUDA-complete return",
        "cache_protocol": "paired cold miss followed by identical warm hit",
