# Copy this file to benchmark.env and replace every path/name for your host.
# Do not put SSH private keys or Hugging Face tokens in this file.

PROJECT_DIR="${PROJECT_DIR:-/absolute/path/to/vllm-gr-benchmark-worktree}"
CONTAINER_NAME="${CONTAINER_NAME:-vllm-gr-benchmark}"
HOST_NAME="${HOST_NAME:-L20}"
GPU_INDEX="${GPU_INDEX:-0}"

# The host PROJECT_DIR must be mounted at this path inside the container.
CONTAINER_PROJECT_DIR="${CONTAINER_PROJECT_DIR:-/opt/vllm-gr}"
CONTAINER_DATA_DIR="${CONTAINER_DATA_DIR:-/opt/vllm-gr/data}"
MODEL_ID="${MODEL_ID:-OpenOneRec/OneRec-1.7B}"
HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"

# Where to publish the results: a clone of the dashboard repository that you
# have push rights to (your own fork, not the upstream repository). Only read
# when PUSH_DASHBOARD=1.
DASHBOARD_DIR="${DASHBOARD_DIR:-/absolute/path/to/vllm-gr-performance-dashboard}"
# 0 collects data locally and stops. 1 additionally commits the new run into
# DASHBOARD_DIR and regenerates the site payload. It defaults to 0 because the
# failure mode is bad: with PUSH_DASHBOARD=1 and an unset or non-git
# DASHBOARD_DIR the runner finishes the entire multi-hour matrix and *then*
# exits 2 without publishing anything. Turn it on once the clone's push
# credentials are known to work.
PUSH_DASHBOARD="${PUSH_DASHBOARD:-0}"

NUM_PROMPTS="${NUM_PROMPTS:-100}"
WARMUP_REQUESTS="${WARMUP_REQUESTS:-4}"
MAX_CONCURRENCY="${MAX_CONCURRENCY:-1}"
GPU_IDLE_LIMIT_MIB="${GPU_IDLE_LIMIT_MIB:-1024}"
# Canonical trend must remain profiler/worker-probe free. Internal stage timing
# is sampled only after canonical requests by run_offline_benchmark.py.
LIGHTWEIGHT_TIMING="${LIGHTWEIGHT_TIMING:-0}"
DIAGNOSTIC_PROMPTS="${DIAGNOSTIC_PROMPTS:-20}"
# Sample count for the per-scenario worker diagnostic, a second benchmark run
# that re-uses the timing instrumentation in a separate process to break down
# host/CPU time. The effective count is max(worker, DIAGNOSTIC_PROMPTS).
# Must be a positive integer.
WORKER_DIAGNOSTIC_PROMPTS="${WORKER_DIAGNOSTIC_PROMPTS:-20}"
VLLM_GR_PREFILL_GRAPH_KV_BOUND="${VLLM_GR_PREFILL_GRAPH_KV_BOUND:-4096}"
AUTO_RESTART_CONTAINER="${AUTO_RESTART_CONTAINER:-1}"

# Used by install_cron.sh. Cron follows the host's local timezone.
CRON_SCHEDULE="${CRON_SCHEDULE:-30 2 * * *}"
CRON_LOG="${CRON_LOG:-/absolute/path/to/vllm-gr-benchmark-worktree/results/daily/cron.log}"
